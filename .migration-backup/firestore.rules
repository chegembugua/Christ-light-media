rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================
    // PUBLIC READABLE CONTENT (Phase 1 + 2)
    // =============================================
    match /portfolio/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /devotions/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /music/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /podcasts/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /sermons/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /news/{docId} { allow read: if true; allow write: if isAdmin(); }

    // =============================================
    // COMMUNITY & USER DATA (Phase 3)
    // =============================================
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    match /prayerRequests/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        (request.auth.uid == resource.data.userId || isAdmin());
    }

    match /comments/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        (request.auth.uid == resource.data.userId || isAdmin());
    }

    match /likes/{docId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /prayerIntercessions/{docId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (request.auth.uid == resource.data.userId || isAdmin());
    }

    match /notifications/{docId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || resource.data.userId == 'all');
      allow write: if request.auth != null && request.auth.uid == resource.data.userId;
      allow read, write: if isAdmin();
    }

    match /reports/{docId} {
      allow create: if request.auth != null;
      allow read, update: if isAdmin();
    }

    match /radioStats/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Helper function
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
