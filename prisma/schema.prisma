// Christ Light Media — complete platform schema (PostgreSQL via Supabase)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum MediaType {
  SERMON
  PODCAST
  MUSIC
  WORSHIP
  RADIO
}

enum DonationType {
  ONE_TIME
  MONTHLY
  PROJECT
}

// ─── User & Auth ─────────────────────────────────────────────────────────────

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  fullName       String?
  role           Role             @default(USER)
  avatarUrl      String?
  bio            String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  prayerRequests PrayerRequest[]
  comments       Comment[]
  enrollments    Enrollment[]
  donations      Donation[]
  notifications  Notification[]
  votes          PrayerVote[]
  movement       MovementMember?
}

// ─── Media ───────────────────────────────────────────────────────────────────

model Media {
  id            String       @id @default(uuid())
  title         String
  description   String?
  coverImage    String?
  audioUrl      String?
  videoUrl      String?
  type          MediaType
  category      String?
  speaker       String?
  duration      String?
  playCount     Int          @default(0)
  isPublished   Boolean      @default(false)
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  podcastShowId String?
  podcastShow   PodcastShow? @relation(fields: [podcastShowId], references: [id], onDelete: SetNull)
  comments      Comment[]
}

model PodcastShow {
  id          String  @id @default(uuid())
  title       String
  description String?
  coverImage  String?
  category    String?
  episodes    Media[]
}

// ─── Devotions & News ────────────────────────────────────────────────────────

model Devotion {
  id          String   @id @default(uuid())
  title       String
  verse       String?
  verseText   String?  @db.Text
  reflection  String?  @db.Text
  date        DateTime @default(now())
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model News {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  content     String?   @db.Text
  excerpt     String?
  coverImage  String?
  category    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

// ─── Community: Prayer ───────────────────────────────────────────────────────

model PrayerRequest {
  id          String       @id @default(uuid())
  title       String
  content     String       @db.Text
  category    String?
  isAnswered  Boolean      @default(false)
  isPublic    Boolean      @default(true)
  prayerCount Int          @default(0)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  votes       PrayerVote[]
}

model PrayerVote {
  id              String        @id @default(uuid())
  userId          String
  prayerRequestId String
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  prayerRequest   PrayerRequest @relation(fields: [prayerRequestId], references: [id], onDelete: Cascade)

  @@unique([userId, prayerRequestId])
}

model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  userId    String
  mediaId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
}

// ─── School (Courses) ────────────────────────────────────────────────────────

model Course {
  id          String         @id @default(uuid())
  title       String
  description String?        @db.Text
  coverImage  String?
  price       Float          @default(0)
  isFree      Boolean        @default(true)
  category    String?
  isPublished Boolean        @default(false)
  createdAt   DateTime       @default(now())
  modules     CourseModule[]
  enrollments Enrollment[]
}

model CourseModule {
  id       String   @id @default(uuid())
  title    String
  order    Int
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
}

model Lesson {
  id       String       @id @default(uuid())
  title    String
  videoUrl String?
  notes    String?      @db.Text
  duration String?
  order    Int
  moduleId String
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id         String   @id @default(uuid())
  userId     String
  courseId   String
  progress   Int      @default(0)
  enrolledAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

// ─── Giving & Movement ─────────────────────────────────────────────────────────

model Donation {
  id            String       @id @default(uuid())
  userId        String?
  amount        Float
  currency      String       @default("USD")
  type          DonationType
  project       String?
  status        String       @default("PENDING")
  paymentMethod String?
  transactionId String?
  createdAt     DateTime     @default(now())
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model MovementMember {
  id           String   @id @default(uuid())
  userId       String   @unique
  joinedAt     DateTime @default(now())
  challengeDay Int      @default(1)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Notifications & Radio ─────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RadioSchedule {
  id        String  @id @default(uuid())
  title     String
  host      String?
  type      String?
  startTime String
  endTime   String
  dayOfWeek Int
  isActive  Boolean @default(true)
}
